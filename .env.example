# Career Compass — Environment Variables
#
# HOW TO USE THIS FILE:
# 1. Copy this file and rename the copy to exactly ".env" (no .txt, no .example)
# 2. Fill in your real keys below — never share this file or commit it to GitHub
# 3. The app reads these automatically via python-dotenv

# O*NET Web Services (API v2) — from https://services.onetcenter.org/
# Log in -> My Account -> look for your API key (v2 uses a single key,
# NOT the old username/password system)
ONET_API_KEY=your_onet_api_key_here

# Gemini API key — from https://aistudio.google.com/  (free, no card needed)
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "false" to skip Gemini entirely and use the template-based report
# generator instead — useful for testing the rest of the app without being
# blocked by Gemini's free-tier rate limits. Defaults to "true" if not set.
USE_GEMINI=true
